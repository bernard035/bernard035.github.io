      <description>&lt;p&gt;&lt;img alt=&#34;图片说明&#34; loading=&#34;lazy&#34; src=&#34;https://bernard035.github.io/images/b79321e282db5671.png&#34;&gt;&lt;/p&gt;
&lt;h2 id=&#34;代码&#34;&gt;代码&lt;/h2&gt;
&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;#define lowbit(x) ((x) &amp;amp; (-x))
ll tree[N];
inline void update(int i, ll x) {
    for (int pos = i; pos &amp;lt; N; pos += lowbit(pos)) tree[pos] += x;
}
inline ll query(int n) {
    ll ans = 0;
    for (int pos = n; pos; pos -= lowbit(pos)) ans += tree[pos];
    return ans;
}
inline ll query(int a, int b) { return query(b) - query(a - 1); }
&lt;/code&gt;&lt;/pre&gt;&lt;h2 id=&#34;what&#34;&gt;What&lt;/h2&gt;
&lt;p&gt;树状数组支持：&lt;/p&gt;</description>
